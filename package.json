{
  "name": "loms-claw",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "type": "module",
  "scripts": {
    "start": "node packages/server/main.ts",
    "dev": "node --watch packages/server/main.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='data/**' --test-coverage-exclude='**/test-helpers.ts' 'packages/**/*.test.ts'",
    "check": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "generate": "npm --prefix docs/api run bundle:json -- ../../packages/server/api/openapi.gen.json && npm run generate --workspace @loms-claw/server"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "typescript": "7.0.2"
  }
}
