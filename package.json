{
  "name": "loms-claw",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "node main.ts",
    "dev": "node --watch main.ts",
    "test": "node --test --experimental-test-coverage --test-coverage-exclude='**/*.test.ts' --test-coverage-exclude='api/internal-schemas.ts' --test-coverage-exclude='data/**' --test-coverage-exclude='test-helpers.ts' '*.test.ts' '{api,approval,bot,claude,cron,store}/**/*.test.ts'",
    "check": "tsc --noEmit",
    "lint": "oxlint && oxfmt --check",
    "fix": "oxlint --fix && oxfmt",
    "generate": "npm --prefix docs/api run bundle:json && npm --prefix docs/api run emit-server-schemas -- ../../api/internal-schemas.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.282",
    "@cfworker/json-schema": "4.1.1",
    "@hono/node-server": "^2.1.4",
    "@js-temporal/polyfill": "^0.5.1",
    "@std/front-matter": "npm:@jsr/std__front-matter@1.0.9",
    "@std/path": "npm:@jsr/std__path@1.1.6",
    "@std/yaml": "npm:@jsr/std__yaml@1.3.0",
    "discord.js": "14.27.0",
    "hono": "4.13.9",
    "json-schema-to-ts": "3.1.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "oxfmt": "^0.72.0",
    "oxlint": "^1.87.0",
    "typescript": "^5.9.3"
  },
  "engines": {
    "node": ">=24"
  }
}
