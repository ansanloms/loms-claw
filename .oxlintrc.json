{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "curly": "error",
    "typescript/no-explicit-any": "error",
    "prefer-const": "error"
  },
  "overrides": [
    {
      "files": ["**/*.test.ts"],
      "rules": {
        "typescript/no-explicit-any": "off"
      }
    },
    {
      "files": ["**/*.ts"],
      "excludeFiles": ["client/**", "main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "discord.js",
                "message": "discord.js は client/discord/ でのみ import する"
              }
            ],
            "patterns": [
              {
                "group": ["**/client/**"],
                "message": "client/ は main.ts からのみ import する (依存は client -> core の一方向)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["client/**/*.ts"],
      "excludeFiles": ["client/discord/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "discord.js",
                "message": "discord.js は client/discord/ でのみ import する"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["main.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "discord.js",
                "message": "discord.js は client/discord/ でのみ import する"
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "data/",
    "docs/api/",
    "coverage/",
    "api/internal-schemas.ts",
    ".claude/"
  ]
}
