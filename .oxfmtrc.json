{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "proseWrap": "preserve",
  "ignorePatterns": [
    "data/**",
    "docs/api/**",
    "api/internal-schemas.ts",
    ".claude/**",
    ".github/workflows/**",
    "**/*.yaml",
    "**/*.yml"
  ]
}
