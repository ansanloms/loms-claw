{
  "name": "loms-claw-api",
  "private": true,
  "type": "module",
  "scripts": {
    "check": "tsc --noEmit",
    "lint": "npm run lint:check && npm run lint:oxc && npm run lint:textlint && npm run lint:redocly",
    "lint:check": "npm run check",
    "lint:oxc": "oxlint && oxfmt --check",
    "lint:textlint": "textlint . --ignore-path ./.gitignore",
    "lint:redocly": "redocly lint --config ./redocly.yaml",
    "fix": "npm run sort; npm run fix:textlint; npm run fix:oxc; npm run lint",
    "fix:oxc": "oxlint --fix; oxfmt",
    "fix:textlint": "textlint . --fix --ignore-path ./.gitignore",
    "build": "npm run build:clean && npm run build:bundle && npm run build:build",
    "build:clean": "rm -rf ./dist",
    "build:bundle": "redocly bundle ./api.yaml --config ./redocly.yaml --ext yaml --output ./dist/api.yaml",
    "build:build": "node ./bin/build.ts ./dist",
    "sort": "node ./bin/sort.ts",
    "list": "node ./bin/list.ts",
    "search": "node ./bin/search.ts",
    "start": "http-server ./dist -p 4000 -a 0.0.0.0 -c-1",
    "dev": "http-server ./ -p 4000 -a 0.0.0.0 -c-1",
    "bundle:json": "redocly bundle ./api.yaml --config ./redocly.yaml --ext json --output ./dist/api.json",
    "emit-server-schemas": "node ./bin/emit-server-schemas.ts ./dist/api.json"
  },
  "devDependencies": {
    "@ansanloms/redocly-plugin-inline-examples": "github:ansanloms/redocly-plugin-inline-examples#0.1.0",
    "@ansanloms/textlint-plugin-yaml-keys": "github:ansanloms/textlint-plugin-yaml-keys#0.1.0",
    "@ansanloms/textlint-rule-preset-ansanloms": "github:ansanloms/textlint-rule-preset-ansanloms#0.1.0",
    "@redocly/cli": "2.57.0",
    "@stoplight/elements": "9.0.25",
    "@types/node": "24.19.1",
    "cli-table3": "0.6.5",
    "gunshi": "0.37.3",
    "http-server": "14.1.1",
    "openapi-types": "12.1.3",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "picocolors": "1.1.1",
    "textlint": "15.8.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
