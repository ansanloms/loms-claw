# docker compose が host 側で参照する変数。アプリ自体は .env を読まない。

# コンテナのタイムゾーン（IANA 形式、デフォルト: Asia/Tokyo）
# 例: Asia/Tokyo, America/New_York
# TZ=Asia/Tokyo

# 稼働サーバの ssh host alias (例: ~/.ssh/config の Host エントリ名)
LOMS_CLAW_PROD_HOST=

# 稼働サーバ上のデプロイ先ルートパス (例: /opt/services/loms-claw)
LOMS_CLAW_PROD_PATH=

# vim:set ft=sh:
