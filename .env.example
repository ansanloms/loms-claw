# docker compose が host 側で参照する変数。アプリ自体は .env を読まない。

# コンテナのタイムゾーン（IANA 形式、デフォルト: Asia/Tokyo）
# 例: Asia/Tokyo, America/New_York
# TZ=Asia/Tokyo

# Google Health API (google-health skill) の OAuth クライアント
GOOGLE_HEALTH_CLIENT_ID=
GOOGLE_HEALTH_CLIENT_SECRET=

# トークン保存先の絶対パス（コンテナ内、デフォルト: /data/home/google-health/token.json）
# GOOGLE_HEALTH_TOKEN_PATH=/data/home/google-health/token.json

# vim:set ft=sh:
