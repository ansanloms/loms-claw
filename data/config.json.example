{
  "$schema": "../config.schema.json",
  "discord": {
    "token": "",
    "guildId": "",
    "userId": "",
    "activeChannelIds": []
  },
  "storePath": ".claude/loms-claw.kv",
  "claude": {
    "maxTurns": 10,
    "timeout": 300000,
    "apiPort": 3000,
    "defaults": {
      "model": "sonnet",
      "effort": "medium",
      "showThinking": false
    }
  },
  "log": {
    "level": "INFO",
    "bufferSize": 1000
  }
}
