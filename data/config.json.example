{
  "$schema": "../config.schema.json",
  "discord": {
    "token": "",
    "guildId": "",
    "userId": "",
    "activeChannelIds": [],
    "selfMention": {
      "enabled": false,
      "maxHops": 3,
      "rateLimit": { "maxCount": 6, "windowMinutes": 10 }
    }
  },
  "storePath": "loms-claw.kv",
  "claude": {
    "maxTurns": 10,
    "verbose": true,
    "timeout": 300000,
    "apiPort": 3000,
    "defaults": {
      "model": "sonnet",
      "effort": "medium",
      "showThinking": false
    }
  },
  "log": {
    "level": "INFO",
    "bufferSize": 1000
  }
}
